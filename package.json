{
  "name": "sparkly-brush",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12.5.1 <13"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "check": "tsc --noEmit",
    "lint": "expo lint app components contexts lib hooks constants --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:stress": "vitest run tests/lifetime-stress.test.ts tests/device-lifetime-stress.test.ts tests/backup-semantic-streaming.test.ts && TZ=America/New_York vitest run tests/timezone-lifetime.test.ts && TZ=Europe/Rome vitest run tests/timezone-lifetime.test.ts && TZ=Pacific/Kiritimati vitest run tests/timezone-lifetime.test.ts",
    "test:a11y:semantic": "vitest run tests/a11y",
    "test:a11y:web": "playwright test -c playwright.config.ts",
    "test:e2e:web": "playwright test -c playwright.functional.config.ts",
    "test:i18n": "vitest run tests/locale.test.ts tests/locale-provider.test.tsx tests/preferences.test.ts tests/preferences-context-race.test.tsx tests/translations.test.ts tests/backup.test.ts tests/hardware-validation.test.ts tests/brush-provider-integration.test.tsx",
    "test:e2e:android": "mkdir -p artifacts/maestro && MAESTRO_CLI_NO_ANALYTICS=1 MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true maestro test .maestro/flows --format JUNIT --output artifacts/maestro/results.xml --test-output-dir artifacts/maestro/debug",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "base64-js": "^1.5.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "^57.0.22",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "57.0.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
